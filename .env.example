# Compose binds locally by default. Public mode is anonymous/read-only; expose only behind TLS and a trusted proxy.
GEO_DEPLOYMENT_MODE=private
GEO_REDIS_URL=redis://geo-events:6379/0
GEO_WEB_BIND=127.0.0.1
GEO_WEB_PORT=8082
GEO_API_BIND=127.0.0.1
GEO_API_PORT=8081
GEO_FORWARDED_ALLOW_IPS=127.0.0.1,::1
GEO_SATELLITE_CATALOG_IDS=25544,51850,60133
GEO_CORS_ORIGINS=http://localhost:5173,https://geo.ag7su.com
GEO_CACHE_TTL_SECONDS=60
GEO_REQUEST_TIMEOUT_SECONDS=12
GEO_USER_AGENT=GeoDashboard/0.1 (self-hosted geographic display)

# WSJT-X local UDP decoder listener; Compose exposes this on loopback only by default.
GEO_WSJT_X_UDP_BIND=127.0.0.1
GEO_WSJT_X_UDP_PORT=2237

# Optional shared edit boundary. If set, send X-Geo-Edit-Token for all write requests.
# Keep this server-side or inject it through a trusted reverse proxy; never commit a real token.
# GEO_EDIT_TOKEN=

# Air traffic: empty uses enabled in private mode, disabled in public mode.
# Review/contact ADSB.lol for production use before explicitly enabling.
GEO_AIR_TRAFFIC_ENABLED=
GEO_AIR_TRAFFIC_LATITUDE=45.64
GEO_AIR_TRAFFIC_LONGITUDE=-122.66
GEO_AIR_TRAFFIC_RADIUS_NM=250
