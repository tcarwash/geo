# Compose binds locally by default. Set to 0.0.0.0 only behind a trusted LAN/VPN/reverse proxy.
GEO_API_BIND=127.0.0.1
GEO_API_PORT=8081
GEO_FORWARDED_ALLOW_IPS=127.0.0.1,::1
GEO_SATELLITE_CATALOG_IDS=25544,51850,60133
GEO_CORS_ORIGINS=http://localhost:5173,https://geo.ag7su.com
GEO_CACHE_TTL_SECONDS=60
GEO_REQUEST_TIMEOUT_SECONDS=12
GEO_USER_AGENT=GeoDashboard/0.1 (self-hosted geographic display)

# Optional shared edit boundary. If set, send X-Geo-Edit-Token for all write requests.
# Keep this server-side or inject it through a trusted reverse proxy; never commit a real token.
# GEO_EDIT_TOKEN=
